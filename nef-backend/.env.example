# Copy to .env and fill in real values. Never commit .env.

# ---- Server ----
PORT=3000
NODE_ENV=development

# Exact origin(s) the frontend is served from, comma-separated. Never "*".
# Local default when empty (development only): http://localhost:5500,http://127.0.0.1:5500
CORS_ORIGIN=http://127.0.0.1:5500

# Number of reverse proxies in front of the app. Defaults to 1 in production
# (Render, Railway, nginx) and off in development.
# TRUST_PROXY=1

# Set to false to turn off public teacher self-registration.
ALLOW_SIGNUP=true

# ---- MySQL ----
# Either a single URL ...
# MYSQL_URL=mysql://nef_user:password@localhost:3306/nef_db
# ... or discrete values:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=nef_db
MYSQL_USER=nef_user
MYSQL_PASSWORD=changeme

# TLS for managed MySQL (Aiven etc.): paste the provider's CA certificate
# (newlines may be written as \n), or set MYSQL_SSL=true to use system CAs.
# MYSQL_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# MYSQL_SSL=true

# ---- Auth ----
# Required. At least 32 characters in production: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10
